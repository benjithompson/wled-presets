# DATABASE_PATH=./data/wled-presets.sqlite
# DISCOVERY_SUBNETS=192.168.1.0/24
# WEB_PORT=5790
# Behind Cloudflare Tunnel: TRUST_PROXY=cloudflare (one reverse proxy such as nginx: TRUST_PROXY=1)
# TRUST_PROXY=cloudflare
